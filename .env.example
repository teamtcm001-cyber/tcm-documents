# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only (Vercel Project Settings -> Environment Variables; NEVER prefix with VITE_, never commit).
# Used by the serverless functions in api/ for the per-person login system:
#   SUPABASE_URL / SUPABASE_ANON_KEY   (optional: fall back to the VITE_ values above)
#   SUPABASE_SERVICE_ROLE_KEY          api/admin-users.js only (Supabase -> Settings -> API -> service_role)
#   DRIVE_URL_SECRET                   >= 32 random characters; signs the short-lived file URLs
#                                      (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN / GOOGLE_DRIVE_FOLDER_ID   Google Drive storage.
#                                      Used SERVER-SIDE ONLY (api/drive-file, drive-upload-session, drive-upload-discard);
#                                      no Google credential is ever sent to the browser. Mint GOOGLE_REFRESH_TOKEN with ONLY
#                                      the https://www.googleapis.com/auth/drive.file scope.
#   APP_ORIGINS                        optional, comma-separated extra browser origins allowed to upload, e.g.
#                                      https://docs.example.com,https://app-preview.example.com
#                                      (the app's own origin - same host as the request - is always allowed)
#   ANTHROPIC_API_KEY                  AI chat (optional)
# The old VITE_SHARED_ACCOUNT_EMAIL / VITE_SHARED_ACCOUNT_PASSWORD are no longer used: delete them everywhere
# (they were compiled into the browser bundle, so treat that password as public).

# Vercel (Optional - for deployment)
VERCEL_TOKEN=your_vercel_token_here
